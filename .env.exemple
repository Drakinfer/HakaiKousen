# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
# ==========================================
# APPLICATION & SYSTEM
# ==========================================
# Base URL of the application (used by NextAuth, email links, redirects)
APP_URL="http://localhost:3000"

# ==========================================
# DATABASE (PostgreSQL / Prisma / Drizzle)
# ==========================================
# PostgreSQL Connection String
DATABASE_URL="postgresql://hakai:hakai@localhost:5432/hakai_db?schema=public"

# ==========================================
# AUTHENTICATION (Auth.js / NextAuth)
# ==========================================
# Generate a secret with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="your-super-secret-auth-key-change-me" # Added by npx auth. Read more: https://cli.authjs.dev/

# Secret key for signing/verifying API JWTs (ex: openssl rand -base64 32)
API_JWT_SECRET="your-jwt-secret-key-at-least-32-chars-long"

# ==========================================
# STORAGE (Vercel Blob / S3)
# ==========================================
# Read/Write access token for file storage
# This is an example string don't use this one
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_0123456789abcdef_ghijklmnopqrstuvwxyz"

# ==========================================
# EMAILING (Resend)
# ==========================================
# API key provided by Resend (ex: re_123456789)
# This is an example string don't use this one
RESEND_API_KEY="re_123456789_AbCdEfGhIjKlMnOpQrStUvWx"

# Validated sender address in your Resend account
MAIL_FROM="Hakai Kousen onboarding@resend.dev"

# ==========================================
# PUPPETEER / PDF GENERATION (Optional)
# ==========================================
# Local path to Chrome binary (used during local development if needed)
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux: /usr/bin/google-chrome
CHROME_EXECUTABLE_PATH="/usr/bin/google-chrome"

# URL for pre-packaged Chromium bundle for Serverless / Vercel deployment
CHROMIUM_PACK_URL=https://github.com/Sparticuz/chromium/releases/download/v147.0.0/chromium-v147.0.0-pack.tar