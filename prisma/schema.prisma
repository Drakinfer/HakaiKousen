datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  id            Int       @id @default(autoincrement())
  createdAt     DateTime  @default(now())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  role          Role      @default(USER)

  passwordHash String?

  accounts Account[]
  sessions Session[]

  // createdPokemons Pokemon[] @relation("CreatedBy")
  // updatedPokemons Pokemon[] @relation("UpdatedBy")
  generatedPokemons GeneratedPokemon[]
}

model Account {
  id                 Int     @id @default(autoincrement())
  userId             Int
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  EDITOR
  ADMIN
}

model Attaque {
  id                 Int                 @id @default(autoincrement())
  name               String              @db.VarChar(50)
  lastTypeId         Int?
  lastType           Type?               @relation(fields: [lastTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attaquesBreeding   AttaqueBreeding[]
  attaquesCt         AttaqueCt[]
  attaquesDt         AttaqueDt[]
  attaqueGenerations AttaqueGeneration[]
  attaquesLvl        AttaqueLvl[]
  attaqueTutoring    AttaqueTutoring[]

  @@index([lastTypeId])
}

model AttaqueGeneration {
  id        Int     @id @default(autoincrement())
  attaqueId Int
  attaque   Attaque @relation(fields: [attaqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  generationId Int
  generation   Generation @relation(fields: [generationId], references: [id])

  typeId Int
  type   Type @relation(fields: [typeId], references: [id])

  energie1    Int
  energie2    Int?
  category    PokemonCategory @default(PHYSIQUE)
  range       Range           @default(CIBLE)
  precision   Int
  damage_base Int
  description String          @db.Text

  @@index([attaqueId])
  @@index([generationId])
  @@index([typeId])
}

enum PokemonCategory {
  PHYSIQUE @map("Physique")
  SPECIAL  @map("Spéciale")
  OTHER    @map("Autre")
}

enum Range {
  CIBLE           @map("Cible")
  MULTIPLE_CIBLES @map("Cibles")
  ALLY            @map("Cible Alliée")
  RANDOM          @map("Cible Aléatoire")
  BLAST           @map("Rayon")
  ZONE            @map("Zone")
  ALLYZONE        @map("Zone Alliée")
  ENNEMIZONE      @map("Zone Ennemie")
  PERSONNAL       @map("Personnel")
  SOUND           @map("Sonore")
}

model AttaqueBreeding {
  id                  Int               @id @default(autoincrement())
  attaqueId           Int
  attaque             Attaque           @relation(fields: [attaqueId], references: [id])
  pokemonGenerationId Int
  pokemonGeneration   PokemonGeneration @relation(fields: [pokemonGenerationId], references: [id])

  @@index([attaqueId])
  @@index([pokemonGenerationId])
}

model AttaqueCt {
  id                  Int               @id @default(autoincrement())
  attaqueId           Int
  attaque             Attaque           @relation(fields: [attaqueId], references: [id])
  pokemonGenerationId Int
  pokemonGeneration   PokemonGeneration @relation(fields: [pokemonGenerationId], references: [id])
  number              Int

  @@index([attaqueId])
  @@index([pokemonGenerationId])
}

model AttaqueDt {
  id                  Int               @id @default(autoincrement())
  attaqueId           Int
  attaque             Attaque           @relation(fields: [attaqueId], references: [id])
  pokemonGenerationId Int
  pokemonGeneration   PokemonGeneration @relation(fields: [pokemonGenerationId], references: [id])
  number              Int

  @@index([attaqueId])
  @@index([pokemonGenerationId])
}

model AttaqueLvl {
  id                  Int               @id @default(autoincrement())
  attaqueId           Int
  attaque             Attaque           @relation(fields: [attaqueId], references: [id])
  pokemonGenerationId Int
  pokemonGeneration   PokemonGeneration @relation(fields: [pokemonGenerationId], references: [id])
  learningWay         String            @db.VarChar(50)

  @@index([attaqueId])
  @@index([pokemonGenerationId])
}

model AttaqueTutoring {
  id                  Int               @id @default(autoincrement())
  attaqueId           Int
  attaque             Attaque           @relation(fields: [attaqueId], references: [id])
  pokemonGenerationId Int
  pokemonGeneration   PokemonGeneration @relation(fields: [pokemonGenerationId], references: [id])

  @@index([attaqueId])
  @@index([pokemonGenerationId])
}

model Evolution {
  id                  Int               @id @default(autoincrement())
  pokemonId           Int
  pokemon             Pokemon           @relation(fields: [pokemonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pokemonGenerationId Int
  pokemonGeneration   PokemonGeneration @relation(fields: [pokemonGenerationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  evolutionWay String @db.VarChar(50)

  @@index([pokemonId])
  @@index([pokemonGenerationId])
}

model Forme {
  id                  Int               @id @default(autoincrement())
  pokemonId           Int
  pokemon             Pokemon           @relation(fields: [pokemonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pokemonGenerationId Int
  pokemonGeneration   PokemonGeneration @relation(fields: [pokemonGenerationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  form                String?           @db.VarChar(50)

  @@index([pokemonGenerationId])
  @@index([pokemonId])
}

model GeneratedPokemon {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  userId Int

  name         String
  lvl          Int
  sex          String?
  nature       String?
  subNature    String?
  talent       String?
  breedingMove String?
  shiny        Boolean @default(false)
  baron        Boolean @default(false)

  stats Json
  hash  String

  createdAt DateTime @default(now())
}

model Generation {
  id                 Int                 @id @default(autoincrement())
  name               String              @db.VarChar(20)
  rank               Int
  attaqueGenerations AttaqueGeneration[]
  pokemons           Pokemon[]
  pokemonGenerations PokemonGeneration[]
  talentGenerations  TalentGeneration[]
  types              Type[]
}

model PokemonGenerationHasTalents {
  id                  Int               @id @default(autoincrement())
  talentId            Int
  pokemonGenerationId Int
  hidden              Boolean
  pokemonGeneration   PokemonGeneration @relation(fields: [pokemonGenerationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  talent              Talent            @relation(fields: [talentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([pokemonGenerationId])
  @@index([talentId])
}

model Pokemon {
  id                    Int                     @id @default(autoincrement())
  name                  String
  category              String
  dexNumber             String
  mainPicture           String
  miniPicture           String
  firstGeneration       Generation?             @relation(fields: [firstGenerationId], references: [id])
  firstGenerationId     Int?
  type                  Type?                   @relation("type", fields: [typeId], references: [id])
  typeId                Int?
  evolutions            Evolution[]
  formes                Forme[]
  // createdAt         DateTime    @default(now())
  // createdBy         User        @relation("CreatedBy", fields: [createdById], references: [id])
  // updatedAt         DateTime    @updatedAt
  // createdById       Int
  // updatedById       Int
  // updatedBy         User        @relation("UpdatedBy", fields: [updatedById], references: [id])
  pokemonGenerations    PokemonGeneration[]
  preEvolutionsOf       PokemonGeneration[]     @relation("PreEvolution")
  pokemonHasCompetences PokemonHasCompetences[]
  pokemonHasLocations   PokemonHasLocations[]
}

model PokemonGeneration {
  id              Int         @id @default(autoincrement())
  pokemonId       Int
  pokemon         Pokemon     @relation(fields: [pokemonId], references: [id])
  generationId    Int
  generation      Generation  @relation(fields: [generationId], references: [id])
  type1Id         Int
  type1           Type        @relation("type1", fields: [type1Id], references: [id])
  type2Id         Int?
  type2           Type?       @relation("type2", fields: [type2Id], references: [id])
  height          Float
  weight          Float
  breedRating     BreedRating @default(MALE)
  vita            Int
  dex             Int
  for             Int
  conc            Int
  end             Int
  vol             Int
  preEvolutionId  Int?
  preEvolution    Pokemon?    @relation("PreEvolution", fields: [preEvolutionId], references: [id])
  preEvolutionWay String?
  description     String?     @db.Text

  attaquesBreeding AttaqueBreeding[]
  attaquesCt       AttaqueCt[]
  attaquesDt       AttaqueDt[]
  attaquesLvl      AttaqueLvl[]
  attaquesTutoring AttaqueTutoring[]
  evolutions       Evolution[]
  formes           Forme[]
  talentsLinks     PokemonGenerationHasTalents[]

  @@index([pokemonId])
  @@index([generationId])
  @@index([type1Id])
  @@index([type2Id])
  @@index([preEvolutionId])
}

enum BreedRating {
  MALE    @map("♂ uniquement")
  R7M1F   @map("7♂:1♀")
  R6M2F   @map("6♂:2♀")
  R5M3F   @map("5♂:3♀")
  R4M4F   @map("4♂:4♀")
  R3M5F   @map("3♂:5♀")
  R2M6F   @map("2♂:6♀")
  R1M7F   @map("1♂:7♀")
  FEMALE  @map("♀ uniquement")
  UNBREED @map("Asexué")

  @@map("breed_rating")
}

model Talent {
  id                          Int                           @id @default(autoincrement())
  name                        String                        @db.VarChar(50)
  oldNameId                   Int?                          @unique
  oldName                     Talent?                       @relation("TalentRenaming", fields: [oldNameId], references: [id])
  renamedTo                   Talent?                       @relation("TalentRenaming")
  pokemonGenerationHasTalents PokemonGenerationHasTalents[]
  talentGenerations           TalentGeneration[]
}

model TalentGeneration {
  id           Int        @id @default(autoincrement())
  talentId     Int
  generationId Int
  description  String     @db.Text
  generation   Generation @relation(fields: [generationId], references: [id])
  talent       Talent     @relation(fields: [talentId], references: [id])

  @@index([talentId])
  @@index([generationId])
}

model Type {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(20)

  bug      Float
  dark     Float?
  dragon   Float
  electric Float
  fairy    Float?
  fighting Float
  fire     Float
  flying   Float
  ghost    Float
  grass    Float
  ground   Float
  ice      Float
  normal   Float
  poison   Float
  psychic  Float
  rock     Float
  steel    Float?
  water    Float

  generationId Int
  generation   Generation @relation(fields: [generationId], references: [id])

  attaqueGenerations AttaqueGeneration[]
  attaques           Attaque[]

  pokemons Pokemon[] @relation("type")

  pokemonGenerationsAsType1 PokemonGeneration[] @relation("type1")
  pokemonGenerationsAsType2 PokemonGeneration[] @relation("type2")

  @@index([generationId])
}

model Competence {
  id                    Int                     @id @default(autoincrement())
  name                  String
  description           String                  @db.Text
  pokemonHasCompetences PokemonHasCompetences[]
}

model PokemonHasCompetences {
  id           Int        @id @default(autoincrement())
  pokemonId    Int
  pokemon      Pokemon    @relation(fields: [pokemonId], references: [id])
  competenceId Int
  competence   Competence @relation(fields: [competenceId], references: [id])
  points       Int
}

model Location {
  id                  Int                   @id @default(autoincrement())
  name                String
  icon                String?
  pokemonHasLocations PokemonHasLocations[]
}

model PokemonHasLocations {
  id         Int      @id @default(autoincrement())
  pokemonId  Int
  pokemon    Pokemon  @relation(fields: [pokemonId], references: [id])
  locationId Int
  location   Location @relation(fields: [locationId], references: [id])
}
